# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (https://supabase.com) ----
# Créez un projet, puis exécutez supabase/schema.sql dans l'éditeur SQL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service (JAMAIS exposée au navigateur) : utilisée uniquement côté serveur.
SUPABASE_SERVICE_ROLE_KEY=

# ---- E-mails transactionnels (https://resend.com) ----
RESEND_API_KEY=
EMAIL_FROM="Restaurant Sankadiokro <no-reply@votre-domaine.ci>"
# Adresse qui reçoit les notifications de réservation et de contact
ADMIN_NOTIFICATION_EMAIL=

# ---- Sécurité ----
# Jeton secret pour les tâches internes (facultatif)
CRON_SECRET=

# ---- Démonstration ----
# Autorise l'aperçu de l'administration SANS Supabase, même en production (déconseillé).
# Hors production (npm run dev), l'aperçu est toujours disponible.
ADMIN_DEMO_PREVIEW=false
